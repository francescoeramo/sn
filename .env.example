# Solo valori pubblici. Senza questi la home mostra il setup e /demo resta utilizzabile.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
# Anteprima locale in sola lettura di WebFinger e attori pubblici. Ignorata in produzione.
FEDERATION_DISCOVERY_PREVIEW=false
# Solo sul server, necessario per eliminare account e file e per manutenzione.
SUPABASE_SECRET_KEY=
# Base64 di 32 byte casuali. Cifra le chiavi private usate per firmare la federazione.
FEDERATION_KEY_SECRET=
# Generare un valore casuale di almeno 32 caratteri per il job di pulizia.
CRON_SECRET=
# Contatto del gestore: finché manca, la registrazione dall'app resta chiusa.
PRIVACY_CONTACT_EMAIL=
